{{!
    @template quizaccess_tagproctoring/report_categories

    Example context (json):
    {
    "categories": [
        {
            "index": 0,
            "icon": "\u26a0",
            "label": "Tab switch",
            "source": "During exam",
            "color": "#2563eb",
            "count": 2
        }
    ]
}
}}
{{#categories}}<div class="tagrep-cat-item" id="tagrep-cat-{{index}}" onclick="tagRepSelectCat({{index}})">
    <span class="tagrep-cat-icon">{{icon}}</span><div class="tagrep-cat-text"><span class="tagrep-cat-label">{{label}}</span><span class="tagrep-cat-src">· {{source}}</span></div>
    <span class="tagrep-cat-badge" style="background:{{color}};">{{count}}</span>
</div>{{/categories}}
{{^categories}}<p class="tagrep-no-flags">{{#str}} report_flags_no_violations, quizaccess_tagproctoring {{/str}}</p>{{/categories}}

        </div>

        <div class="tagwiz-info-col">
          <p class="tagwiz-section-title">{{#str}} wizard_id_checklist_title, quizaccess_tagproctoring {{/str}}</p>
          <ul class="tagwiz-list">
            <li>{{#str}} wizard_id_checklist_1, quizaccess_tagproctoring {{/str}}</li>
            <li>{{#str}} wizard_id_checklist_2, quizaccess_tagproctoring {{/str}}</li>
            <li>{{#str}} wizard_id_checklist_3, quizaccess_tagproctoring {{/str}}</li>
          </ul>
          <div class="tagwiz-id-tip">
            {{#str}} wizard_id_tip, quizaccess_tagproctoring {{/str}}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="tagwiz-step-4" class="tagwiz-card" style="display:none">
    <div class="tagwiz-card-header">
      <div class="tagwiz-badge tagwiz-badge--screen">05</div>
      <div>
        <h4 class="tagwiz-title">{{#str}} wizard_step4_title, quizaccess_tagproctoring {{/str}}</h4>
        <p class="tagwiz-subtitle">{{#str}} wizard_step4_sub, quizaccess_tagproctoring {{/str}}</p>
      </div>
    </div>
    <div class="tagwiz-card-body">
      <div class="tagwiz-ss-center">
        <div id="tagwiz-ss-before" class="tagwiz-ss-before">
          <p class="tagwiz-ss-before-title">{{#str}} wizard_ss_before_title, quizaccess_tagproctoring {{/str}}</p>
          <div class="tagwiz-ss-guide">
            <div class="tagwiz-ss-guide-step">
              <span class="tagwiz-ss-guide-num">1</span>
              <div class="tagwiz-ss-guide-text">
                {{#str}} wizard_ss_guide_step1, quizaccess_tagproctoring {{/str}}
                <span class="tagwiz-ss-guide-warn">{{#str}} wizard_ss_guide_step1_warn, quizaccess_tagproctoring {{/str}}</span>
              </div>
            </div>
            <div class="tagwiz-ss-guide-step">
              <span class="tagwiz-ss-guide-num">2</span>
              <div class="tagwiz-ss-guide-text">{{#str}} wizard_ss_guide_step2, quizaccess_tagproctoring {{/str}}</div>
            </div>
            <div class="tagwiz-ss-guide-step">
              <span class="tagwiz-ss-guide-num">3</span>
              <div class="tagwiz-ss-guide-text">{{#str}} wizard_ss_guide_step3, quizaccess_tagproctoring {{/str}}</div>
            </div>
          </div>
        </div>

        <div id="tagwiz-ss-multimon" class="tagwiz-ss-multimon" style="display:none">
          <div class="tagwiz-ss-multimon-header">
            <span class="tagwiz-ss-multimon-icon">!</span>
            <strong>{{#str}} wizard_ss_multimon_header, quizaccess_tagproctoring {{/str}}</strong>
          </div>
          <p class="tagwiz-ss-multimon-desc">
            {{#str}} wizard_ss_multimon_desc, quizaccess_tagproctoring {{/str}}
          </p>
          <button type="button" class="tagwiz-btn tagwiz-btn--recheck" id="tagwiz-ss-recheck">
            {{#str}} wizard_btn_recheck, quizaccess_tagproctoring {{/str}}
          </button>
        </div>

        <p id="tagwiz-ss-status" class="tagwiz-status-msg"></p>

        <div id="tagwiz-checklist" class="tagwiz-checklist" style="display:none">
          <div class="tagwiz-checklist-title">{{#str}} wizard_checklist_title, quizaccess_tagproctoring {{/str}}</div>
          <ul class="tagwiz-checklist-list">
            <li><span class="tagwiz-chk-mark">&#x2713;</span> {{#str}} wizard_chk_rules, quizaccess_tagproctoring {{/str}}</li>
            <li id="tagwiz-chk-scan"><span class="tagwiz-chk-mark">&#x2713;</span> {{#str}} wizard_chk_scan, quizaccess_tagproctoring {{/str}}</li>
            <li><span class="tagwiz-chk-mark">&#x2713;</span> {{#str}} wizard_chk_selfie, quizaccess_tagproctoring {{/str}}</li>
            <li><span class="tagwiz-chk-mark">&#x2713;</span> {{#str}} wizard_chk_idphoto, quizaccess_tagproctoring {{/str}}</li>
            <li><span class="tagwiz-chk-mark">&#x2713;</span> {{#str}} wizard_chk_screenshare, quizaccess_tagproctoring {{/str}}</li>
            <li><span class="tagwiz-chk-mark">&#x2713;</span> {{#str}} wizard_chk_fullscreen, quizaccess_tagproctoring {{/str}}</li>
          </ul>
          <button type="button" class="tagwiz-btn tagwiz-btn--start" id="tagwiz-start-quiz">
            {{#str}} wizard_btn_start_exam, quizaccess_tagproctoring {{/str}}
          </button>
        </div>

        <div class="tagwiz-ss-actions" style="display:none">
          <button type="button" class="tagwiz-btn tagwiz-btn--share tagwiz-btn--round" id="tagwiz-ss-share" aria-label="{{#str}} wizard_btn_share_screen, quizaccess_tagproctoring {{/str}}">
            <span aria-hidden="true">&rsaquo;</span>
          </button>
        </div>
      </div>
    </div>
  </div>

</div>

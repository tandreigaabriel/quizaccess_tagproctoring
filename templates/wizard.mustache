        <span class="tagwiz-ind-num">3</span>
        <span class="tagwiz-ind-icon"></span>
      </div>
      <div class="tagwiz-ind-label">{{#str}} wizard_step_selfie, quizaccess_tagproctoring {{/str}}</div>

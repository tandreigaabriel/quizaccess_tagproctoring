        </div>

        <div class="tagwiz-rule-slide" id="tagwiz-rule-slide-1" style="display:none">
          <div class="tagwiz-rule-slide-label">{{#str}} wizard_slide1_label, quizaccess_tagproctoring {{/str}}</div>
          <h3 class="tagwiz-rule-slide-heading">{{#str}} wizard_slide1_heading, quizaccess_tagproctoring {{/str}}</h3>
          <p class="tagwiz-rule-slide-sub">{{#str}} wizard_slide1_sub, quizaccess_tagproctoring {{/str}}</p>
        </div>

        <div class="tagwiz-rule-slide" id="tagwiz-rule-slide-2" style="display:none">
          <div class="tagwiz-rule-slide-label">{{#str}} wizard_slide2_label, quizaccess_tagproctoring {{/str}}</div>
          <h3 class="tagwiz-rule-slide-heading">{{#str}} wizard_slide2_heading, quizaccess_tagproctoring {{/str}}</h3>
          <p class="tagwiz-rule-slide-sub">{{#str}} wizard_slide2_sub, quizaccess_tagproctoring {{/str}}</p>
        </div>

        <div class="tagwiz-rule-slide" id="tagwiz-rule-slide-3" style="display:none">
          <div class="tagwiz-rule-slide-label">{{#str}} wizard_slide3_label, quizaccess_tagproctoring {{/str}}</div>
          <h3 class="tagwiz-rule-slide-heading">{{#str}} wizard_slide3_heading, quizaccess_tagproctoring {{/str}}</h3>

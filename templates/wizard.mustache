          <p class="tagwiz-rule-slide-sub">{{#str}} wizard_slide9_sub, quizaccess_tagproctoring {{/str}}</p>
          <div class="tagwiz-rule-consent-warn">
            {{#str}} wizard_consent_warn, quizaccess_tagproctoring {{/str}}
          </div>
        </div>

      </div>

      <div class="tagwiz-rule-nav">
        <span class="tagwiz-rule-counter" id="tagwiz-rule-counter">1 of 10</span>
        <div class="tagwiz-rule-progress-bar">
          <div class="tagwiz-rule-progress-fill" id="tagwiz-rule-progress-fill" style="width:10%"></div>
        </div>
      </div>

      <div class="tagwiz-actions">
        <button type="button" class="tagwiz-btn tagwiz-btn--primary" id="tagwiz-rules-next">
          {{#str}} wizard_btn_next, quizaccess_tagproctoring {{/str}} →
        </button>
      </div>

    </div>
  </div>

  <div id="tagwiz-step-1" class="tagwiz-card" style="display:none">
    <div class="tagwiz-card-header">
      <div class="tagwiz-badge tagwiz-badge--scan">02</div>
      <div>
        <h4 class="tagwiz-title">{{#str}} wizard_step1_title, quizaccess_tagproctoring {{/str}}</h4>
        <p class="tagwiz-subtitle">{{#str}} wizard_step1_sub, quizaccess_tagproctoring {{/str}}</p>
      </div>
    </div>
    <div class="tagwiz-card-body">
      <div class="tagwiz-room-intro">
        {{#str}} wizard_roomscan_intro, quizaccess_tagproctoring {{/str}}
      </div>
      <div class="tagwiz-grid">
        <div>
          <div class="tagwiz-video-wrap">
            <video id="tagwiz-rs-video" autoplay muted playsinline></video>
            <div class="tagwiz-overlay">
              <div class="tagwiz-overlay-inner">
                <span class="tagwiz-dot" id="tagwiz-rs-dot"></span>
                <span class="tagwiz-overlay-status" id="tagwiz-rs-status"></span>
                <span class="tagwiz-overlay-timer" id="tagwiz-rs-timer"></span>
              </div>
            </div>
          </div>
          <div class="tagwiz-cam-actions">
            <button type="button" class="tagwiz-btn tagwiz-btn--record" id="tagwiz-rs-start">
              {{#str}} wizard_btn_start_scan, quizaccess_tagproctoring {{/str}}
            </button>
            <button type="button" class="tagwiz-btn tagwiz-btn--next" id="tagwiz-rs-next" disabled>
              {{#str}} wizard_btn_next_step, quizaccess_tagproctoring {{/str}}
            </button>
          </div>
        </div>

        <div class="tagwiz-info-col">
          <p class="tagwiz-section-title">{{#str}} wizard_scan_checklist_title, quizaccess_tagproctoring {{/str}}</p>
          <ul class="tagwiz-list">
            <li>{{#str}} wizard_scan_checklist_1, quizaccess_tagproctoring {{/str}}</li>
            <li>{{#str}} wizard_scan_checklist_2, quizaccess_tagproctoring {{/str}}</li>
            <li>{{#str}} wizard_scan_checklist_3, quizaccess_tagproctoring {{/str}}</li>
            <li>{{#str}} wizard_scan_checklist_4, quizaccess_tagproctoring {{/str}}</li>
            <li>{{#str}} wizard_scan_checklist_5, quizaccess_tagproctoring {{/str}}</li>
          </ul>
          <div id="tagwiz-rs-success" style="display:none" class="tagwiz-success">
            {{#str}} wizard_scan_success, quizaccess_tagproctoring {{/str}}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="tagwiz-step-2" class="tagwiz-card" style="display:none">
    <div class="tagwiz-card-header">
      <div class="tagwiz-badge tagwiz-badge--selfie">03</div>
      <div>
        <h4 class="tagwiz-title">{{#str}} wizard_step2_title, quizaccess_tagproctoring {{/str}}</h4>
        <p class="tagwiz-subtitle">{{#str}} wizard_step2_sub, quizaccess_tagproctoring {{/str}}</p>
      </div>
    </div>
    <div class="tagwiz-card-body">
      <div class="tagwiz-grid">
        <div>
          <div class="tagwiz-video-wrap tagwiz-video-wrap--selfie" style="position:relative;overflow:hidden;">
            <video id="tagwiz-selfie-video" autoplay muted playsinline
              style="position:absolute;top:0;left:0;width:100%;height:100%;opacity:0;pointer-events:none;"></video>
            <canvas id="tagwiz-selfie-canvas" style="display:block;width:100%;height:100%;"></canvas>
            <div class="tagwiz-selfie-guide"></div>
            <div id="tagwiz-selfie-countdown" class="tagwiz-selfie-countdown" style="display:none">3</div>
          </div>
          <div id="tagwiz-selfie-preview-wrap" style="display:none" class="tagwiz-preview-wrap">
            <img id="tagwiz-selfie-preview" class="tagwiz-preview-img" alt="Selfie preview" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7">
            <div class="tagwiz-preview-badge">{{#str}} wizard_captured, quizaccess_tagproctoring {{/str}}</div>
          </div>
          <p id="tagwiz-selfie-status" class="tagwiz-status-msg"></p>
          <div class="tagwiz-cam-actions">
            <button type="button" class="tagwiz-btn tagwiz-btn--capture tagwiz-btn--camera" id="tagwiz-selfie-capture" aria-label="{{#str}} wizard_btn_take_photo, quizaccess_tagproctoring {{/str}}">
              <span aria-hidden="true">CAM</span>
            </button>
            <button type="button" class="tagwiz-btn tagwiz-btn--retake" id="tagwiz-selfie-retake" style="display:none">
              {{#str}} wizard_btn_retake, quizaccess_tagproctoring {{/str}}
            </button>
            <button type="button" class="tagwiz-btn tagwiz-btn--next" id="tagwiz-selfie-next" disabled>
              {{#str}} wizard_btn_next_step, quizaccess_tagproctoring {{/str}}
            </button>
          </div>
        </div>

        <div class="tagwiz-info-col">
          <p class="tagwiz-section-title">{{#str}} wizard_selfie_checklist_title, quizaccess_tagproctoring {{/str}}</p>
          <ul class="tagwiz-list">
            <li>{{#str}} wizard_selfie_checklist_1, quizaccess_tagproctoring {{/str}}</li>
            <li>{{#str}} wizard_selfie_checklist_2, quizaccess_tagproctoring {{/str}}</li>
            <li>{{#str}} wizard_selfie_checklist_3, quizaccess_tagproctoring {{/str}}</li>
            <li>{{#str}} wizard_selfie_checklist_4, quizaccess_tagproctoring {{/str}}</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div id="tagwiz-step-3" class="tagwiz-card" style="display:none">
    <div class="tagwiz-card-header">
      <div class="tagwiz-badge tagwiz-badge--id">04</div>
      <div>
        <h4 class="tagwiz-title">{{#str}} wizard_step3_title, quizaccess_tagproctoring {{/str}}</h4>
        <p class="tagwiz-subtitle">{{#str}} wizard_step3_sub, quizaccess_tagproctoring {{/str}}</p>
      </div>
    </div>
    <div class="tagwiz-card-body">
      <div class="tagwiz-grid">
        <div>
          <div class="tagwiz-video-wrap tagwiz-video-wrap--id">
            <video id="tagwiz-id-video" autoplay muted playsinline></video>
            <div id="tagwiz-id-countdown" class="tagwiz-id-countdown" style="display:none">3</div>
            <div id="tagwiz-id-guide" class="tagwiz-id-guide">
              <span id="tagwiz-id-guide-label" class="tagwiz-id-guide-label">{{#str}} wizard_id_guide_label, quizaccess_tagproctoring {{/str}}</span>
            </div>
          </div>
          <div id="tagwiz-id-preview-wrap" style="display:none" class="tagwiz-preview-wrap">
            <img id="tagwiz-id-preview" class="tagwiz-preview-img" alt="ID photo preview" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7">
            <div class="tagwiz-preview-badge">{{#str}} wizard_captured, quizaccess_tagproctoring {{/str}}</div>
          </div>
          <p id="tagwiz-id-status" class="tagwiz-status-msg"></p>
          <div class="tagwiz-cam-actions">
            <button type="button" class="tagwiz-btn tagwiz-btn--capture tagwiz-btn--camera" id="tagwiz-id-capture" aria-label="{{#str}} wizard_btn_take_id_photo, quizaccess_tagproctoring {{/str}}">
              <span aria-hidden="true">CAM</span>
            </button>
            <button type="button" class="tagwiz-btn tagwiz-btn--retake" id="tagwiz-id-retake" style="display:none">
              {{#str}} wizard_btn_retake, quizaccess_tagproctoring {{/str}}

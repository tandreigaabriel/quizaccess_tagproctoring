{{!
    @template quizaccess_tagproctoring/wizard

    Pre-exam proctoring wizard: rules, room scan, selfie, ID photo, screen share.

    @package    quizaccess_tagproctoring
    @copyright  2026 Andrei Toma <https://www.tandreig.com>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="tagwiz-wrap tagwiz-wrap--guided" id="tagwiz-wrap">

  <div class="tagwiz-hero">
    <div class="tagwiz-hero-icon">TAG</div>
    <div>
      <div class="tagwiz-hero-title">Secure Exam Check</div>
      <div class="tagwiz-hero-sub">Complete each check before the quiz opens. Evidence is collected only for exam integrity review.</div>
    </div>
  </div>

  <div class="tagwiz-bar">
    <div class="tagwiz-ind tagwiz-ind--active" id="tagwiz-ind-0">
      <div class="tagwiz-ind-circle">
        <span class="tagwiz-ind-num">1</span>
        <span class="tagwiz-ind-icon"></span>
      </div>
      <div class="tagwiz-ind-label">Rules</div>
    </div>
    <div class="tagwiz-connector" id="tagwiz-conn-0"></div>

    <div class="tagwiz-ind" id="tagwiz-ind-1">
      <div class="tagwiz-ind-circle">
        <span class="tagwiz-ind-num">2</span>
        <span class="tagwiz-ind-icon"></span>
      </div>
      <div class="tagwiz-ind-label">Room Scan</div>
    </div>
    <div class="tagwiz-connector" id="tagwiz-conn-1"></div>

    <div class="tagwiz-ind" id="tagwiz-ind-2">
      <div class="tagwiz-ind-circle">
        <span class="tagwiz-ind-num">3</span>
        <span class="tagwiz-ind-icon"></span>
      </div>
      <div class="tagwiz-ind-label">Selfie</div>
    </div>
    <div class="tagwiz-connector" id="tagwiz-conn-2"></div>

    <div class="tagwiz-ind" id="tagwiz-ind-3">
      <div class="tagwiz-ind-circle">
        <span class="tagwiz-ind-num">4</span>
        <span class="tagwiz-ind-icon"></span>
      </div>
      <div class="tagwiz-ind-label">ID Photo</div>
    </div>
    <div class="tagwiz-connector" id="tagwiz-conn-3"></div>

    <div class="tagwiz-ind" id="tagwiz-ind-4">
      <div class="tagwiz-ind-circle">
        <span class="tagwiz-ind-num">5</span>
        <span class="tagwiz-ind-icon"></span>
      </div>
      <div class="tagwiz-ind-label">Screen</div>
    </div>
  </div>

  <div id="tagwiz-step-0" class="tagwiz-card tagwiz-card--intro">
    <div class="tagwiz-card-header">
      <div class="tagwiz-badge tagwiz-badge--rules">01</div>
      <div>
        <h4 class="tagwiz-title">Rules and Privacy</h4>
        <p class="tagwiz-subtitle">Read to the bottom, then confirm you understand the monitored exam rules.</p>
      </div>
    </div>
    <div class="tagwiz-card-body">
      <div class="tagwiz-rules-box" id="tagwiz-rules-scroll">
        <div class="tagwiz-privacy-panel">
          <h5>Privacy commitment</h5>
          <ul>
            <li>Minimizing what is collected</li>
            <li>Keeping only what is required</li>
            <li>Sharing only with authorized reviewers</li>
            <li>Deleting evidence according to retention settings</li>
          </ul>
        </div>

        <p class="tagwiz-rules-intro">
          Your setup checks, screen-share evidence, and selected activity events may be reviewed by your invigilator.
        </p>

        <div class="tagwiz-rule-groups" aria-label="Proctoring rules">
          <div class="tagwiz-rule-row"><span class="tagwiz-rule-icon">CAM</span><span>Keep your face visible to the webcam and do not leave camera view.</span></div>
          <div class="tagwiz-rule-row"><span class="tagwiz-rule-icon">MSG</span><span>Do not use messaging apps such as Zoom, Slack, Discord, Teams, or chat tools.</span></div>
          <div class="tagwiz-rule-row"><span class="tagwiz-rule-icon">MIC</span><span>Do not talk to another person or receive help during the exam.</span></div>
          <div class="tagwiz-rule-row"><span class="tagwiz-rule-icon">ONE</span><span>You must be alone. No other people may be present in the room.</span></div>
          <div class="tagwiz-rule-row"><span class="tagwiz-rule-icon">AI</span><span>Do not use active AI tools, remote access tools, or automation software.</span></div>
          <div class="tagwiz-rule-row"><span class="tagwiz-rule-icon">DEV</span><span>No phones, tablets, smart devices, headphones, books, notes, or external materials.</span></div>
          <div class="tagwiz-rule-row"><span class="tagwiz-rule-icon">SCAN</span><span>You must complete a room and desk scan before starting.</span></div>
          <div class="tagwiz-rule-row"><span class="tagwiz-rule-icon">SCR</span><span>Use only one monitor, stay in fullscreen, and do not stop sharing your screen.</span></div>
        </div>

        <div class="tagwiz-rules-warning">
          <strong>Important:</strong> Leaving the exam view, stopping screen share, using extra displays, or showing prohibited items may mark the attempt for review.
        </div>
      </div>
      <div class="tagwiz-scroll-hint" id="tagwiz-rules-scroll-hint">Scroll to the end of the rules to continue</div>

      <div class="tagwiz-agree-row">
        <label class="tagwiz-agree-label">
          <span class="tagwiz-agree-checkbox-wrap">
            <input type="checkbox" id="tagwiz-rules-agree" disabled>
          </span>
          I have read, understood, and agree to the proctoring rules above.
        </label>
      </div>
      <div class="tagwiz-rules-confirmed" id="tagwiz-rules-confirmed" style="display:none">
        Rules accepted
      </div>

      <div class="tagwiz-actions">
        <button type="button" class="tagwiz-btn tagwiz-btn--primary tagwiz-btn--round" id="tagwiz-rules-next" disabled aria-label="Continue">
          <span aria-hidden="true">&rsaquo;</span>
        </button>
      </div>
    </div>
  </div>

  <div id="tagwiz-step-1" class="tagwiz-card" style="display:none">
    <div class="tagwiz-card-header">
      <div class="tagwiz-badge tagwiz-badge--scan">02</div>
      <div>
        <h4 class="tagwiz-title">Room and Desk Scan</h4>
        <p class="tagwiz-subtitle">Record a 30-45 second scan before the exam begins.</p>
      </div>
    </div>
    <div class="tagwiz-card-body">
      <div class="tagwiz-room-intro">
        Capture the entire room, including walls, ceiling to floor, desk area, and underneath the desk. Remove unauthorized items before recording.
      </div>
      <div class="tagwiz-grid">
        <div>
          <div class="tagwiz-video-wrap">
            <video id="tagwiz-rs-video" autoplay muted playsinline></video>
            <div class="tagwiz-overlay">
              <div class="tagwiz-overlay-inner">
                <span class="tagwiz-dot" id="tagwiz-rs-dot"></span>
                <span class="tagwiz-overlay-status" id="tagwiz-rs-status"></span>
                <span class="tagwiz-overlay-timer" id="tagwiz-rs-timer"></span>
              </div>
            </div>
          </div>
          <div class="tagwiz-cam-actions">
            <button type="button" class="tagwiz-btn tagwiz-btn--record" id="tagwiz-rs-start">
              Start room scan
            </button>
            <button type="button" class="tagwiz-btn tagwiz-btn--next" id="tagwiz-rs-next" disabled>
              Next
            </button>
          </div>
        </div>

        <div class="tagwiz-info-col">
          <p class="tagwiz-section-title">Scan checklist</p>
          <ul class="tagwiz-list">
            <li>Allow camera access when prompted.</li>
            <li>Slowly pan 360 degrees around your room.</li>
            <li>Show your desk, keyboard, floor, and surrounding area.</li>
            <li>Show there are no phones, notes, books, or other people.</li>
            <li>Recording stops automatically after the configured duration.</li>
          </ul>
          <div id="tagwiz-rs-success" style="display:none" class="tagwiz-success">
            Room scan uploaded successfully.
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="tagwiz-step-2" class="tagwiz-card" style="display:none">
    <div class="tagwiz-card-header">
      <div class="tagwiz-badge tagwiz-badge--selfie">03</div>
      <div>
        <h4 class="tagwiz-title">Identity Selfie</h4>
        <p class="tagwiz-subtitle">Take a clear photo of your face for identity review.</p>
      </div>
    </div>
    <div class="tagwiz-card-body">
      <div class="tagwiz-grid">
        <div>
          <div class="tagwiz-video-wrap tagwiz-video-wrap--selfie" style="position:relative;overflow:hidden;">
            <video id="tagwiz-selfie-video" autoplay muted playsinline
              style="position:absolute;top:0;left:0;width:100%;height:100%;opacity:0;pointer-events:none;"></video>
            <canvas id="tagwiz-selfie-canvas" style="display:block;width:100%;height:100%;"></canvas>
            <div class="tagwiz-selfie-guide"></div>
            <div id="tagwiz-selfie-countdown" class="tagwiz-selfie-countdown" style="display:none">3</div>
          </div>
          <div id="tagwiz-selfie-preview-wrap" style="display:none" class="tagwiz-preview-wrap">
            <img id="tagwiz-selfie-preview" class="tagwiz-preview-img" src="" alt="Selfie preview">
            <div class="tagwiz-preview-badge">Captured</div>
          </div>
          <p id="tagwiz-selfie-status" class="tagwiz-status-msg"></p>
          <div class="tagwiz-cam-actions">
            <button type="button" class="tagwiz-btn tagwiz-btn--capture tagwiz-btn--camera" id="tagwiz-selfie-capture" aria-label="Take photo">
              <span aria-hidden="true">CAM</span>
            </button>
            <button type="button" class="tagwiz-btn tagwiz-btn--retake" id="tagwiz-selfie-retake" style="display:none">
              Retake
            </button>
            <button type="button" class="tagwiz-btn tagwiz-btn--next" id="tagwiz-selfie-next" disabled>
              Next
            </button>
          </div>
        </div>

        <div class="tagwiz-info-col">
          <p class="tagwiz-section-title">Selfie checklist</p>
          <ul class="tagwiz-list">
            <li>Look directly at the camera.</li>
            <li>Keep your face well-lit and centered in the oval.</li>
            <li>Remove hats or anything that hides your face.</li>
            <li>The photo can capture automatically after a stable face is detected.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div id="tagwiz-step-3" class="tagwiz-card" style="display:none">
    <div class="tagwiz-card-header">
      <div class="tagwiz-badge tagwiz-badge--id">04</div>
      <div>
        <h4 class="tagwiz-title">Photo ID Verification</h4>
        <p class="tagwiz-subtitle">Hold your government-issued photo ID up to the camera.</p>
      </div>
    </div>
    <div class="tagwiz-card-body">
      <div class="tagwiz-grid">
        <div>
          <div class="tagwiz-video-wrap tagwiz-video-wrap--id">
            <video id="tagwiz-id-video" autoplay muted playsinline></video>
            <div id="tagwiz-id-countdown" class="tagwiz-id-countdown" style="display:none">3</div>
            <div id="tagwiz-id-guide" class="tagwiz-id-guide">
              <span id="tagwiz-id-guide-label" class="tagwiz-id-guide-label">Place your ID inside the green box</span>
            </div>
          </div>
          <div id="tagwiz-id-preview-wrap" style="display:none" class="tagwiz-preview-wrap">
            <img id="tagwiz-id-preview" class="tagwiz-preview-img" src="" alt="ID photo preview">
            <div class="tagwiz-preview-badge">Captured</div>
          </div>
          <p id="tagwiz-id-status" class="tagwiz-status-msg"></p>
          <div class="tagwiz-cam-actions">
            <button type="button" class="tagwiz-btn tagwiz-btn--capture tagwiz-btn--camera" id="tagwiz-id-capture" aria-label="Take ID photo">
              <span aria-hidden="true">CAM</span>
            </button>
            <button type="button" class="tagwiz-btn tagwiz-btn--retake" id="tagwiz-id-retake" style="display:none">
              Retake
            </button>
            <button type="button" class="tagwiz-btn tagwiz-btn--next" id="tagwiz-id-next" disabled>
              Next
            </button>
          </div>
        </div>

        <div class="tagwiz-info-col">
          <p class="tagwiz-section-title">ID checklist</p>
          <ul class="tagwiz-list">
            <li>Keep your face visible above or beside the ID.</li>
            <li>The name, photo, and ID number must be readable.</li>
            <li>Hold still until the capture completes.</li>
          </ul>
          <div class="tagwiz-id-tip">
            Use the green border guide to align your ID card.
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="tagwiz-step-4" class="tagwiz-card" style="display:none">
    <div class="tagwiz-card-header">
      <div class="tagwiz-badge tagwiz-badge--screen">05</div>
      <div>
        <h4 class="tagwiz-title">Screen Share Verification</h4>
        <p class="tagwiz-subtitle">Share your entire screen before the secure exam starts.</p>
      </div>
    </div>
    <div class="tagwiz-card-body">
      <div class="tagwiz-ss-center">
        <div id="tagwiz-ss-before" class="tagwiz-ss-before">
          <p class="tagwiz-ss-before-title">When the browser dialog opens, select your entire screen. Human reviewers may see your screen evidence.</p>
          <div class="tagwiz-ss-guide">
            <div class="tagwiz-ss-guide-step">
              <span class="tagwiz-ss-guide-num">1</span>
              <div class="tagwiz-ss-guide-text">
                Click the <strong>Entire Screen</strong> tab
                <span class="tagwiz-ss-guide-warn">Do not choose Window or Tab</span>
              </div>
            </div>
            <div class="tagwiz-ss-guide-step">
              <span class="tagwiz-ss-guide-num">2</span>
              <div class="tagwiz-ss-guide-text">Select the monitor you will use for the exam</div>
            </div>
            <div class="tagwiz-ss-guide-step">
              <span class="tagwiz-ss-guide-num">3</span>
              <div class="tagwiz-ss-guide-text">Click <strong>Share</strong> and keep sharing until submission</div>
            </div>
          </div>
        </div>

        <div id="tagwiz-ss-multimon" class="tagwiz-ss-multimon" style="display:none">
          <div class="tagwiz-ss-multimon-header">
            <span class="tagwiz-ss-multimon-icon">!</span>
            <strong>Additional monitor detected</strong>
          </div>
          <p class="tagwiz-ss-multimon-desc">
            Disconnect secondary monitors or set displays to Mirror / Duplicate mode before continuing.
          </p>
          <button type="button" class="tagwiz-btn tagwiz-btn--recheck" id="tagwiz-ss-recheck">
            Re-check setup
          </button>
        </div>

        <p id="tagwiz-ss-status" class="tagwiz-status-msg"></p>

        <div id="tagwiz-checklist" class="tagwiz-checklist" style="display:none">
          <div class="tagwiz-checklist-title">All checks passed. You are ready to begin.</div>
          <ul class="tagwiz-checklist-list">
            <li><span class="tagwiz-chk-mark">&#x2713;</span> Rules accepted</li>
            <li id="tagwiz-chk-scan"><span class="tagwiz-chk-mark">&#x2713;</span> Room scan completed</li>
            <li><span class="tagwiz-chk-mark">&#x2713;</span> Identity selfie saved</li>
            <li><span class="tagwiz-chk-mark">&#x2713;</span> Photo ID captured</li>
            <li><span class="tagwiz-chk-mark">&#x2713;</span> Screen sharing confirmed</li>
            <li><span class="tagwiz-chk-mark">&#x2713;</span> Fullscreen will be enforced on start</li>
          </ul>
          <button type="button" class="tagwiz-btn tagwiz-btn--start" id="tagwiz-start-quiz">
            Start Secure Exam
          </button>
        </div>

        <div class="tagwiz-ss-actions">
          <button type="button" class="tagwiz-btn tagwiz-btn--share tagwiz-btn--round" id="tagwiz-ss-share" aria-label="Share screen">
            <span aria-hidden="true">&rsaquo;</span>
          </button>
        </div>
      </div>
    </div>
  </div>

</div>

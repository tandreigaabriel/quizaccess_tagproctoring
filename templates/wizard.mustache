        <div class="tagwiz-rule-slide" id="tagwiz-rule-slide-4" style="display:none">
          <div class="tagwiz-rule-slide-label">{{#str}} wizard_slide4_label, quizaccess_tagproctoring {{/str}}</div>
          <h3 class="tagwiz-rule-slide-heading">{{#str}} wizard_slide4_heading, quizaccess_tagproctoring {{/str}}</h3>
          <p class="tagwiz-rule-slide-sub">{{#str}} wizard_slide4_sub, quizaccess_tagproctoring {{/str}}</p>
        </div>

        <div class="tagwiz-rule-slide" id="tagwiz-rule-slide-5" style="display:none">
          <div class="tagwiz-rule-slide-label">{{#str}} wizard_slide5_label, quizaccess_tagproctoring {{/str}}</div>
          <h3 class="tagwiz-rule-slide-heading">{{#str}} wizard_slide5_heading, quizaccess_tagproctoring {{/str}}</h3>
          <p class="tagwiz-rule-slide-sub">{{#str}} wizard_slide5_sub, quizaccess_tagproctoring {{/str}}</p>
        </div>

        <div class="tagwiz-rule-slide" id="tagwiz-rule-slide-6" style="display:none">
          <div class="tagwiz-rule-slide-label">{{#str}} wizard_slide6_label, quizaccess_tagproctoring {{/str}}</div>
          <h3 class="tagwiz-rule-slide-heading">{{#str}} wizard_slide6_heading, quizaccess_tagproctoring {{/str}}</h3>
          <p class="tagwiz-rule-slide-sub">{{#str}} wizard_slide6_sub, quizaccess_tagproctoring {{/str}}</p>
        </div>

        <div class="tagwiz-rule-slide" id="tagwiz-rule-slide-7" style="display:none">
          <div class="tagwiz-rule-slide-label">{{#str}} wizard_slide7_label, quizaccess_tagproctoring {{/str}}</div>
          <h3 class="tagwiz-rule-slide-heading">{{#str}} wizard_slide7_heading, quizaccess_tagproctoring {{/str}}</h3>
          <p class="tagwiz-rule-slide-sub">{{#str}} wizard_slide7_sub, quizaccess_tagproctoring {{/str}}</p>
        </div>

        <div class="tagwiz-rule-slide" id="tagwiz-rule-slide-8" style="display:none">
          <div class="tagwiz-rule-slide-label">{{#str}} wizard_slide8_label, quizaccess_tagproctoring {{/str}}</div>
          <h3 class="tagwiz-rule-slide-heading">{{#str}} wizard_slide8_heading, quizaccess_tagproctoring {{/str}}</h3>
          <p class="tagwiz-rule-slide-sub">{{#str}} wizard_slide8_sub, quizaccess_tagproctoring {{/str}}</p>
        </div>

        <div class="tagwiz-rule-slide tagwiz-rule-slide--consent" id="tagwiz-rule-slide-9" style="display:none">
          <div class="tagwiz-rule-slide-label">{{#str}} wizard_slide9_label, quizaccess_tagproctoring {{/str}}</div>

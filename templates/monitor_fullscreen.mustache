    @template quizaccess_tagproctoring/monitor_fullscreen
    Example context (json):
    {"title": "Full screen required", "message": "Enter fullscreen.", "subtitle": "Share entire screen.", "count": "0", "button": "Continue", "buttonbg": "#334155", "border": "#334155", "panelbg": "#334155"}
}}
<div style="background:{{panelbg}};border:1.5px solid {{border}};border-radius:16px;padding:32px 40px;max-width:480px;width:100%;text-align:center">
    <h2>{{title}}</h2><p>{{message}}</p><p>{{subtitle}}</p><p>{{count}}</p>
    <button id="tagproctor-fs-reenter" style="padding:12px 28px;border:0;border-radius:8px;background:{{buttonbg}};color:#fff">{{button}}</button>
</div>

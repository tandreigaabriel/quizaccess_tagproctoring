{{!
    @template quizaccess_tagproctoring/report_sessions

    Example context (json):
    {
    "name": "Student",
    "email": "student@example.com",
    "count": 1,
    "attempts": [
        {
            "userid": 1,
            "id": 2,
            "number": 1,
            "badge": {
                "color": "#16a34a",
                "label": "Valid"
            },
            "summary": {
                "body": "No violations",
                "risk": "Valid",
                "color": "#16a34a"
            },
            "info": [
                {
                    "label": "Events",
                    "value": 0
                }
            ],
            "objects": [],
            "reviewurl": "https://example.com"
        }
    ]
}
}}
<div class="tagrep-card">
    <div class="tagrep-card-hd"><div><h4 class="tagrep-title">{{name}}</h4><p class="tagrep-subtitle">{{email}} · {{#str}} mmr_attempt_count, quizaccess_tagproctoring, {{count}} {{/str}}</p></div></div>
    <div class="tagrep-sessions-grid">{{#attempts}}
        <div class="tagrep-session-card">
            <div class="tagrep-session-hd"><span class="tagrep-session-num">{{#str}} report_label_attempt_num, quizaccess_tagproctoring {{/str}}{{number}}</span>{{#badge}}{{> quizaccess_tagproctoring/report_badge}}{{/badge}}</div>
            {{#summary}}{{> quizaccess_tagproctoring/report_summary}}{{/summary}}
            <div class="tagrep-session-body">
                <div class="tagrep-session-photo"><div style="display:flex;gap:8px;align-items:flex-start;">
                    {{#scan.selfie_url}}<a href="{{scan.selfie_url}}" target="_blank" rel="noopener"><img src="{{scan.selfie_url}}" class="tagrep-selfie-img" alt="{{#str}} report_label_selfie, quizaccess_tagproctoring {{/str}}"></a>{{/scan.selfie_url}}
                    {{^scan.selfie_url}}<div class="tagrep-selfie-ph">{{#str}} mmr_no_selfie, quizaccess_tagproctoring {{/str}}</div>{{/scan.selfie_url}}
                    {{#scan.idphoto_url}}<a href="{{scan.idphoto_url}}" target="_blank" rel="noopener"><img src="{{scan.idphoto_url}}" class="tagrep-selfie-img" alt="{{#str}} report_label_idphoto, quizaccess_tagproctoring {{/str}}"></a>{{/scan.idphoto_url}}
                </div></div>
                <div class="tagrep-session-info">{{#info}}<div class="tagrep-info-row"><span class="tagrep-info-lbl">{{label}}</span><span class="tagrep-info-val">{{value}}</span></div>{{/info}}</div>
                {{#identity}}<div class="tagrep-identity-row"><span class="tagrep-badge" style="background:{{color}};">{{label}}</span>
                    {{#verify}}<button class="tagrep-btn tagrep-btn--outline" onclick="tagRepSetIdentity({{userid}},{{id}},1)">{{#str}} report_identity_mark_verified, quizaccess_tagproctoring {{/str}}</button>{{/verify}}
                    {{#fail}}<button class="tagrep-btn tagrep-btn--outline" onclick="tagRepSetIdentity({{userid}},{{id}},0)">{{#str}} report_identity_mark_failed, quizaccess_tagproctoring {{/str}}</button>{{/fail}}
                    {{#clear}}<button class="tagrep-btn tagrep-btn--outline" onclick="tagRepSetIdentity({{userid}},{{id}},-1)">{{#str}} mmr_clear_identity, quizaccess_tagproctoring {{/str}}</button>{{/clear}}
                </div>{{/identity}}
            </div>
            <div class="tagrep-scan-chips">{{#objects}}<span class="tagrep-scan-chip" style="background:{{color}};">{{label}} ×{{count}}</span>{{/objects}}</div>
            <div class="tagrep-session-actions">
                {{#flags}}<button class="tagrep-btn tagrep-btn--danger" onclick="tagRepOpenFlags({{userid}},{{id}})">{{#str}} report_action_view_flags, quizaccess_tagproctoring {{/str}}</button>{{/flags}}
                {{#override}}<button class="tagrep-btn tagrep-btn--outline" onclick="tagRepSetOverride({{userid}},{{id}},0)">{{#str}} report_action_clear_override, quizaccess_tagproctoring {{/str}}</button>{{/override}}
                {{^override}}<button class="tagrep-btn tagrep-btn--outline" onclick="tagRepSetOverride({{userid}},{{id}},1)">{{#str}} report_action_mark_valid, quizaccess_tagproctoring {{/str}}</button>{{/override}}
                {{#reviewed}}<button class="tagrep-btn tagrep-btn--outline" onclick="tagRepSetReviewed({{userid}},{{id}},0)">{{#str}} report_action_reviewed_undo, quizaccess_tagproctoring {{/str}}</button>{{/reviewed}}
                {{^reviewed}}<button class="tagrep-btn tagrep-btn--outline" onclick="tagRepSetReviewed({{userid}},{{id}},1)">{{#str}} report_action_mark_reviewed, quizaccess_tagproctoring {{/str}}</button>{{/reviewed}}
                <a href="{{reviewurl}}" target="_blank" rel="noopener" class="tagrep-btn tagrep-btn--outline">{{#str}} report_action_quiz_results, quizaccess_tagproctoring {{/str}}</a>
            </div>
            <div class="tagrep-session-deletes">
                {{#events}}<button class="tagrep-btn tagrep-btn--delete" onclick="tagRepDeleteEvents({{userid}},{{id}})">{{#str}} report_action_delete_events, quizaccess_tagproctoring {{/str}} ({{events}})</button>{{/events}}
                {{#screenshots}}<button class="tagrep-btn tagrep-btn--delete" onclick="tagRepDeleteScreenshots({{userid}},{{id}})">{{#str}} report_action_delete_evidence, quizaccess_tagproctoring {{/str}} ({{screenshots}})</button>{{/screenshots}}
                {{#deletescan}}<a href="{{deleteurl}}" class="tagrep-btn tagrep-btn--delete">{{#str}} report_action_delete_scan, quizaccess_tagproctoring {{/str}}</a>{{/deletescan}}
            </div>
        </div>
    {{/attempts}}</div>
</div>

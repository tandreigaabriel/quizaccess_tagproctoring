{{!
    @template quizaccess_tagproctoring/report_students

    Example context (json):
    {
    "exampletable": true,
    "rows": [
        {
            "name": "Student",
            "email": "student@example.com",
            "userid": 1,
            "count": 2,
            "last": "12 Jul",
            "badge": {
                "color": "#16a34a",
                "label": "Valid"
            }
        }
    ]
}
}}
{{! The example wrapper lets the HTML validator check table rows as a complete document. }}
{{#exampletable}}<table><tbody>{{/exampletable}}
{{#rows}}
<tr>
    <td><strong>{{name}}</strong></td><td class="tagrep-muted">{{email}}</td>
    <td class="tagrep-center">{{count}}</td><td class="tagrep-muted">{{last}}</td>
    <td>{{#badge}}{{> quizaccess_tagproctoring/report_badge}}{{/badge}}</td>
    <td class="tagrep-td-action"><button class="tagrep-btn tagrep-btn--primary" onclick="tagRepOpenStudent({{userid}})">{{#str}} report_action_view_sessions, quizaccess_tagproctoring {{/str}} →</button></td>
</tr>
{{/rows}}

{{#exampletable}}</tbody></table>{{/exampletable}}

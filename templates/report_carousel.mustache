{{!
    @template quizaccess_tagproctoring/report_carousel

    Example context (json):
    {
    "thumbnails": [
        {
            "class": "tagrep-carousel-thumb",
            "index": 0,
            "url": "https://example.com/image.jpg",
            "time": "12:00",
            "source": "Webcam",
            "name": "Student"
        }
    ]
}
}}
{{#thumbnails}}<div class="{{class}}" id="tagrep-thumb-{{index}}" onclick="tagRepOpenLightbox({{index}})" title="{{#str}} mmr_enlarge, quizaccess_tagproctoring {{/str}}">
    {{#suspicious}}<span class="tagrep-suspicious-dot"></span>{{/suspicious}}
    <img src="{{url}}" alt="{{#str}} mmr_screenshot, quizaccess_tagproctoring {{/str}}" loading="lazy">
    <div class="tagrep-carousel-caption"><span class="tagrep-carousel-time">{{time}}</span><span class="tagrep-carousel-source">{{source}}</span><span class="tagrep-carousel-name">{{name}}</span></div>
</div>{{/thumbnails}}
